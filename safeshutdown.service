[Unit]
Description=SafeShutdown — 系统安全监护程序
Documentation=https://github.com/youyou/safeshutdown
DefaultDependencies=no
After=sysinit.target
Before=shutdown.target reboot.target halt.target

[Service]
Type=simple
# -d 前台运行不守护化，由 systemd 管理进程生命周期
ExecStart=/usr/local/sbin/safeshutdown -d
# 最高调度优先级，系统满载时仍能抢到 CPU
Nice=-20
ExecStopPost=/usr/bin/sync
Restart=on-failure
RestartSec=5
LimitRSS=16M
LimitNOFILE=32
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_BOOT CAP_SYS_RAWIO
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=~AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
